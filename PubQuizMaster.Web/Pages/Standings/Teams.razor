@page "/teams"
@using PubQuizMaster.Core
@using PubQuizMaster.Services.Standings
@using PubQuizMaster.Web.Components.Charts
@using PubQuizMaster.Web.Components.Standings
@inject TeamService TeamService
@inject ToastService ToastService

<PageTitle>Teams – PubQuizMaster</PageTitle>
<SectionContent SectionName="@Constants.PageTitle">Teams</SectionContent>

<div class="row g-3">
    <!-- Left Column: Add Team & Team List with inline rename -->
    <div class="col-12 col-lg-5">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header pqm-card-header">
                <span class="pqm-card-title">
                    <span class="mif-plus" aria-hidden="true"></span> Register New Team
                </span>
            </div>
            <div class="card-body">
                <TeamSelector 
                    @bind-Value="newTeamName"
                    OnCreateNewConfirmed="CreateTeamAsync"
                    OnTeamSelected="SelectExistingTeamAsync"
                    Placeholder="Enter new team name…"
                    AddButtonText="Create Team" />
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header pqm-card-header">
                <span class="pqm-card-title">
                    <span class="mif-group" aria-hidden="true"></span> All Teams (@teams.Length)
                </span>
                <SearchBox 
                    @bind-Value="filterQuery"
                    Placeholder="Filter list…"
                    AriaLabel="Filter teams"
                    Style="width: 200px;" />
            </div>
            <div class="list-group list-group-flush" style="max-height: 620px; overflow-y: auto;">
                @foreach (var team in FilteredTeams)
                {
                    var isSelected = selectedTeam?.Id == team.Id;

                    @* Light selection color, the rename button must stay readable on it *@
                    <div class="list-group-item list-group-item-action py-2 @(isSelected ? "list-group-item-primary" : null)"
                         style="cursor: pointer;"
                         @key="team.Id"
                         @onclick="() => SelectTeamAsync(team)">
                        <div class="fw-semibold">
                            <TeamNameEditor 
                                TeamId="team.Id"
                                Name="@team.Name"
                                OnRenamed="HandleRenamedAsync"
                                OnMerged="HandleMergedAsync" />
                        </div>
                        <small class="text-muted">Created: @team.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: History and merge of the selected team -->
    <div class="col-12 col-lg-7">
        @if (selectedTeam == null)
        {
            <div class="card shadow-sm border-0 p-4 text-center text-muted">
                Select a team to see its quiz nights or to merge a duplicate.
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header pqm-card-header">
                    <span class="pqm-card-title text-truncate">
                        <span class="mif-line-chart" aria-hidden="true"></span> @selectedTeam.Name
                    </span>
                    <span class="small text-muted">@history.Length quiz nights</span>
                </div>
                <div class="card-body">
                    @if (isLoadingHistory)
                    {
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span>Loading quiz nights…</span>
                        </div>
                    }
                    else if (history.Length == 0)
                    {
                        <div class="text-muted small">No completed quiz nights yet.</div>
                    }
                    else
                    {
                        <LineChart 
                            Labels="HistoryLabels"
                            Series="HistorySeries"
                            AriaLabel="Points per quiz night" />

                        <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="small text-secondary">
                                    <tr>
                                        <th style="width: 100px;">Date</th>
                                        <th>Quiz Night</th>
                                        <th class="text-end" style="width: 80px;">Points</th>
                                        <th class="text-end" style="width: 80px;" title="Night average">Avg</th>
                                        <th class="text-end" style="width: 90px;">Place</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var entry in history.AsEnumerable().Reverse())
                                    {
                                        <tr>
                                            <td class="text-secondary">@entry.Date.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <a class="text-decoration-none" href="/quiz/@entry.QuizId">@entry.Title</a>
                                            </td>
                                            <td class="text-end fw-semibold">@entry.Score.ToString("0.#")</td>
                                            <td class="text-end text-muted">@entry.AverageScore.ToString("0.#")</td>
                                            <td class="text-end">@(entry.Rank is { } rank ? $"{rank} / {entry.TeamCount}" : "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Merge Tool -->
            <div class="card shadow-sm border-0">
                <div class="card-header pqm-card-header">
                    <span class="pqm-card-title text-danger">
                        <span class="mif-warning" aria-hidden="true"></span> Merge Into Another Team
                    </span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">
                        Move all answers, rounds, scorer assignments, participations and legacy scores of <strong>@selectedTeam.Name</strong> into another team, then delete this duplicate.
                        Where both teams have an entry for the same question or legacy quiz night, the target team's entry is kept.
                    </p>
                    <div class="d-flex gap-2 flex-wrap">
                        <select class="form-select form-select-sm flex-grow-1" style="min-width: 200px;" @bind="targetMergeTeamId">
                            <option value="@Guid.Empty">— Select target destination team —</option>
                            @foreach (var t in teams.Where(t => t.Id != selectedTeam.Id))
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                        <button class="btn btn-danger btn-sm d-flex align-items-center justify-content-center gap-1"
                                disabled="@(targetMergeTeamId == Guid.Empty || isBusy)"
                                @onclick="() => showMergeModal = true">
                            <span class="mif-warning" aria-hidden="true"></span> Merge and Remove Duplicate
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<ConfirmModal 
    IsOpen="@showMergeModal"
    Title="Merge Teams"
    Message="@($"Merge \"{selectedTeam?.Name}\" into \"{MergeTargetName}\"? \"{selectedTeam?.Name}\" will be deleted. This cannot be undone.")"
    ConfirmText="Merge"
    OnConfirmed="MergeTeamsAsync"
    OnCanceled="() => showMergeModal = false" />
