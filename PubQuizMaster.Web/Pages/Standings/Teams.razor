@page "/teams"
@using PubQuizMaster.Core
@using PubQuizMaster.Services.Standings
@using PubQuizMaster.Web.Components.Standings
@inject TeamService TeamService
@inject ToastService ToastService

<PageTitle>Teams – PubQuizMaster</PageTitle>
<SectionContent SectionName="@Constants.PageTitle">Teams</SectionContent>

<div class="row g-3">
    <!-- Left Column: Register, Merge, Team List with inline rename -->
    <div class="col-12 col-lg-5">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header pqm-card-header">
                <span class="pqm-card-title">
                    <span class="mif-plus" aria-hidden="true"></span> Register New Team
                </span>
            </div>
            <div class="card-body">
                <TeamSelector 
                    @bind-Value="newTeamName"
                    OnCreateNewConfirmed="CreateTeamAsync"
                    OnTeamSelected="SelectExistingTeam"
                    Placeholder="Enter new team name…"
                    AddButtonText="Create Team" />
            </div>
        </div>

        @* Always shown, so the list below does not jump when a team gets selected *@
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header pqm-card-header">
                <span class="pqm-card-title text-danger">
                    <span class="mif-warning" aria-hidden="true"></span> Merge Duplicate
                </span>
            </div>
            <div class="card-body">
                @if (selectedTeam == null)
                {
                    <div class="small text-muted">
                        Select a team in the list to merge it into another team.
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-2">
                        Moves all answers, participations and legacy scores of <strong>@selectedTeam.Name</strong>
                        into the target team, then deletes <strong>@selectedTeam.Name</strong>.
                        On conflicts the target team's entry is kept.
                    </p>
                    <div class="d-flex gap-2 flex-wrap">
                        <select class="form-select form-select-sm flex-grow-1" style="min-width: 180px;" @bind="targetMergeTeamId">
                            <option value="@Guid.Empty">— Select target team —</option>
                            @foreach (var t in teams.Where(t => t.Id != selectedTeam.Id))
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                        <button class="btn btn-danger btn-sm d-flex align-items-center justify-content-center gap-1"
                                disabled="@(targetMergeTeamId == Guid.Empty || isBusy)"
                                @onclick="() => showMergeModal = true">
                            <span class="mif-warning" aria-hidden="true"></span> Merge
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header pqm-card-header">
                <span class="pqm-card-title">
                    <span class="mif-group" aria-hidden="true"></span> All Teams (@teams.Length)
                </span>
                <SearchBox 
                    @bind-Value="filterQuery"
                    Placeholder="Filter list…"
                    AriaLabel="Filter teams"
                    Style="width: 200px;" />
            </div>
            <div class="list-group list-group-flush" style="max-height: 620px; overflow-y: auto;">
                @foreach (var team in FilteredTeams)
                {
                    var isSelected = selectedTeam?.Id == team.Id;

                    @* Light selection color, the rename button must stay readable on it *@
                    <div class="list-group-item list-group-item-action py-2 @(isSelected ? "list-group-item-primary" : null)"
                         style="cursor: pointer;"
                         @key="team.Id"
                         @onclick="() => SelectTeam(team)">
                        <div class="fw-semibold">
                            <TeamNameEditor 
                                TeamId="team.Id"
                                Name="@team.Name"
                                OnRenamed="HandleRenamedAsync"
                                OnMerged="HandleMergedAsync" />
                        </div>
                        <small class="text-muted">Created: @team.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Quiz nights of the selected team -->
    <div class="col-12 col-lg-7">
        <div class="sticky-lg-top" style="top: 1rem;">
            @if (selectedTeam == null)
            {
                <div class="card shadow-sm border-0 p-4 text-center text-muted">
                    Select a team to see its quiz nights.
                </div>
            }
            else
            {
                @* The version forces a reload after merges, they change the history of the same team *@
                <TeamHistoryPanel 
                    @key="(selectedTeam.Id, historyVersion)"
                    TeamId="selectedTeam.Id"
                    TeamName="@selectedTeam.Name" />
            }
        </div>
    </div>
</div>

<ConfirmModal 
    IsOpen="@showMergeModal"
    Title="Merge Teams"
    Message="@($"Merge \"{selectedTeam?.Name}\" into \"{MergeTargetName}\"? \"{selectedTeam?.Name}\" will be deleted. This cannot be undone.")"
    ConfirmText="Merge"
    OnConfirmed="MergeTeamsAsync"
    OnCanceled="() => showMergeModal = false" />
