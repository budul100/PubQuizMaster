@page "/standings"
@using PubQuizMaster.Core
@using PubQuizMaster.Core.Models.Standings
@using PubQuizMaster.Services
@using PubQuizMaster.Services.Standings
@using PubQuizMaster.Web.Components.Standings
@using PubQuizMaster.Web.Enums
@inject LeaderboardService LeaderboardService

<PageTitle>Standings – PubQuizMaster</PageTitle>
<SectionContent SectionName="@Constants.PageTitle">Standings</SectionContent>

<div class="card shadow-sm border-0">
    <div class="card-header pqm-card-header flex-wrap">
        <span class="pqm-card-title">
            <span class="mif-trophy" aria-hidden="true"></span> Ranking
        </span>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @* Choice between labels, not an action: text instead of icons *@
            <div class="btn-group btn-group-sm" role="group" aria-label="Rank by">
                <button type="button"
                        class="btn @(sort == StandingsSort.Total ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Total ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Total)">
                    Total
                </button>
                <button type="button"
                        class="btn @(sort == StandingsSort.Average ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Average ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Average)">
                    Average
                </button>
                <button type="button"
                        class="btn @(sort == StandingsSort.Quizzes ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Quizzes ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Quizzes)">
                    Quizzes
                </button>
            </div>
            <input type="search"
                   class="form-control form-control-sm"
                   style="width: 200px;"
                   placeholder="Search team…"
                   aria-label="Search team"
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (sort == StandingsSort.Average && data != null)
    {
        <div class="small text-muted px-3 py-2 border-bottom">
            Only teams that played at least @data.MinQuizzesForAverage of @data.QuizCount quiz nights (10 %) are ranked by average.
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-3">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Calculating standings…</span>
        </div>
    }
    else if (FilteredRows.Length == 0)
    {
        <div class="text-center text-muted p-4">
            No teams or rankings found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="small text-secondary">
                    <tr>
                        <th>Team</th>
                        <th style="width: 130px;" class="text-center @HeaderClass(StandingsSort.Total)">Total</th>
                        <th style="width: 130px;" class="text-center pe-3 @HeaderClass(StandingsSort.Average)">Avg / Quiz</th>
                        <th style="width: 130px;" class="text-center @HeaderClass(StandingsSort.Quizzes)">Quizzes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        var entry = row.Team;

                        <tr>
                            <td class="fw-semibold">
                                <a class="text-decoration-none text-dark" href="/teams?teamId=@entry.TeamId">
                                    @entry.TeamName
                                </a>
                            </td>
                            <td class="text-center @CellClass(StandingsSort.Total)">
                                <span class="pqm-rank-value">
                                    <span>@entry.TotalScore.ToString("0.#")</span>
                                    <RankBadge 
                                        Rank="row.TotalRank" />
                                </span>
                            </td>
                            <td class="text-center pe-3 @CellClass(StandingsSort.Average)">
                                <span class="pqm-rank-value">
                                    <span>@entry.AverageScore.ToString("0.#")</span>
                                    <RankBadge 
                                        Rank="row.AverageRank" />
                                </span>
                            </td>
                            <td class="text-center @CellClass(StandingsSort.Quizzes)">
                                <span class="pqm-rank-value">
                                    <span>@entry.QuizzesPlayed</span>
                                    <RankBadge 
                                        Rank="row.QuizzesRank" />
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

