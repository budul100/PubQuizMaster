@page "/"
@namespace PubQuizMaster.Web.Pages
@inject QuizService QuizService
@inject QuizStatsService QuizStatsService
@inject ScorerService SessionService
@implements IDisposable

<PageTitle>PubQuizMaster</PageTitle>
<SectionContent SectionName="@Constants.PageTitle">Quizzes</SectionContent>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted py-5 justify-content-center">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading…</span>
    </div>
}
else
{
    <QuizPanel 
        QuizNights="@allQuizzes"
        Difficulties="@difficulties"
        OnDataChanged="HandleQuizDeletedAsync" />
}
