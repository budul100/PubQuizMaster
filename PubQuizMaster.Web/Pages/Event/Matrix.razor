@page "/matrix/{RoundId:guid}"
@using PubQuizMaster.Services
@using PubQuizMaster.Services.Common
@inject QuizService LiveQuizService
@inject ScorerService SessionService
@inject ToastService ToastService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Matrix – @(round?.Name ?? "Round")</PageTitle>
<SectionContent SectionName="@LayoutSections.PageTitle">@(round == null ? "Matrix" : $"Matrix · {round.Name}")</SectionContent>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading matrix…</span>
    </div>
}
else if (round == null)
{
    <div class="alert alert-danger">Round not found.</div>
}
else
{
    @* Round name is shown in the top row, this toolbar only carries the context and the way back *@
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
        <small class="text-muted">@teams.Length teams, @round.QuestionCount questions</small>
        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="chkFinalRound"
                       checked="@round.IsFinal"
                       disabled="@isSavingFinal"
                       @onchange="e => SetFinalRoundAsync((bool)(e.Value ?? false))" />
                <label class="form-check-label small" for="chkFinalRound">Final round</label>
            </div>
            <a class="btn btn-outline-secondary btn-sm"
               href="/"
               title="Back to dashboard"
               aria-label="Back to dashboard">
                <span class="mif-arrow-left" aria-hidden="true"></span>
            </a>
        </div>
    </div>

    <div class="table-responsive border rounded bg-white shadow-sm">
        <table class="table table-sm table-bordered text-center align-middle mb-0 matrix-table">
            <thead class="table-light">
                <tr>
                    <th class="text-start ps-3" style="min-width: 180px;">Team</th>
                    <th style="width: 48px;" title="Round Rank">#R</th>
                    <th style="width: 52px;" title="Round Points">Pts</th>
                    <th style="width: 48px;" title="Overall Evening Rank">#T</th>
                    <th style="width: 55px;" title="Overall Evening Points">Tot</th>
                    @for (int q = 0; q < round.QuestionCount; q++)
                    {
                        var qNum = q + 1;
                        <th style="width: 40px;">Q@(qNum)</th>
                    }
                </tr>
                <tr class="table-secondary fw-semibold">
                    <td class="text-start ps-3">Total Correct</td>
                    <td>—</td>
                    <td class="text-success fw-bold">@columnSums.Sum()</td>
                    <td>—</td>
                    <td>—</td>
                    @for (int q = 0; q < round.QuestionCount; q++)
                    {
                        var colIdx = q;
                        <td class="text-success">@columnSums[colIdx]</td>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="text-start ps-3 fw-semibold text-truncate" style="max-width: 220px;">
                            @row.TeamName
                            @if (row.IsNonCompetitive)
                            {
                                <span class="badge bg-secondary ms-1" title="Out of competition">OOC</span>
                            }
                        </td>
                        <td class="text-muted small">@row.RoundRank</td>
                        <td class="fw-bold text-success">@row.RoundScore</td>
                        <td class="text-secondary small">@row.OverallRank</td>
                        <td class="fw-bold text-primary">@row.OverallScore.ToString("0.#")</td>

                        @for (int q = 0; q < round.QuestionCount; q++)
                        {
                            var qIdx = q;
                            var isCorrect = row.Answers[qIdx];

                            <td class="matrix-cell cursor-pointer p-0"
                                @onclick="() => ToggleAnswerAsync(row.TeamId, qIdx)">
                                @if (isCorrect)
                                {
                                    <span class="mif-checkmark text-success fw-bold" aria-label="Correct"></span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
