@page "/legacy-import"
@using PubQuizMaster.Core
@using PubQuizMaster.Web.Components.Standings
@inject ImportService LegacyImportService
@inject ToastService ToastService

<PageTitle>Pub Quiz Master - Import</PageTitle>
<SectionContent SectionName="@Constants.PageTitle">Import</SectionContent>

<div class="card shadow-sm border-0 mb-3" style="max-width: 700px;">
    <div class="card-header pqm-card-header">
        <span class="pqm-card-title">
            <span class="mif-upload" aria-hidden="true"></span> Excel Import
        </span>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">Import historic aggregated quiz night records from spreadsheet tables.</p>
        <div class="mb-3">
            <label class="form-label fw-semibold">Select Excel File (.xlsx)</label>
            <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="form-control" />
            <div class="form-text">
                Expected column layout: <strong>A</strong> Date, <strong>B</strong> Title, <strong>C</strong> Remarks/Description, <strong>D</strong> Rank, <strong>E</strong> Team Name, <strong>F</strong> Total Points,
                <strong>G</strong> Questions, <strong>H</strong> Rounds (both optional, per night on any of its rows).
                Rows without team name import the quiz night only, e.g. with a remark.
                A team's creation date is the date of its first quiz night.
                Importing the same file again updates existing results instead of duplicating them,
                so a file with the question and round counts can be imported over earlier imports.
                With the question count, imported nights show their share of correct answers in the quiz statistics.
            </div>
        </div>

        @if (selectedFile != null)
        {
            <div class="alert alert-info py-2 small mb-3">
                Selected: <strong>@selectedFile.Name</strong> (@(selectedFile.Size / 1024) KB)
            </div>

            <button class="btn btn-primary d-flex align-items-center gap-1" @onclick="ExecuteImportAsync" disabled="@isProcessing">
                <span class="mif-upload" aria-hidden="true"></span>
                @(isProcessing ? "Importing records…" : "Start Import")
            </button>
        }
    </div>
</div>

@if (summary != null)
{
    <div class="card shadow-sm border-0 mb-3" style="max-width: 700px;">
        <div class="card-header pqm-card-header">
            <span class="pqm-card-title">
                <span class="mif-checkmark text-success" aria-hidden="true"></span> Import Completed
            </span>
        </div>
        <div class="card-body">
            <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
                <li><span class="mif-checkmark text-success me-1" aria-hidden="true"></span> <strong>@summary.QuizzesCreated</strong> Quiz Nights imported</li>
                <li><span class="mif-pencil text-warning me-1" aria-hidden="true"></span> <strong>@summary.QuizzesUpdated</strong> Quiz Nights with new question or round counts</li>
                <li><span class="mif-group text-primary me-1" aria-hidden="true"></span> <strong>@summary.TeamsCreated</strong> New Teams registered</li>
                <li><span class="mif-calendar text-primary me-1" aria-hidden="true"></span> <strong>@summary.TeamsBackdated</strong> Existing teams dated back to their first quiz night</li>
                <li><span class="mif-bar-chart text-info me-1" aria-hidden="true"></span> <strong>@summary.ResultsCreated</strong> Team results recorded</li>
                <li><span class="mif-pencil text-warning me-1" aria-hidden="true"></span> <strong>@summary.ResultsUpdated</strong> Existing results updated</li>
                <li><span class="text-muted me-2">—</span> <strong>@summary.ResultsUnchanged</strong> Existing results unchanged</li>
            </ul>

            @if (summary.Warnings.Length > 0)
            {
                <hr />
                <h6 class="text-warning-emphasis fw-bold d-flex align-items-center gap-1">
                    <span class="mif-warning" aria-hidden="true"></span> Warnings:
                </h6>
                <div class="small text-muted" style="max-height: 160px; overflow-y: auto;">
                    @foreach (var warning in summary.Warnings)
                    {
                        <div class="d-flex align-items-center gap-1">
                            <span class="mif-warning text-warning" aria-hidden="true"></span> @warning
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}


