@page "/standings"
@using PubQuizMaster.Services
@using PubQuizMaster.Services.Player
@using PubQuizMaster.Web.Enums
@inject LeaderboardService LeaderboardService

<PageTitle>All-Time Standings – PubQuizMaster</PageTitle>
<SectionContent SectionName="@LayoutSections.PageTitle">All-Time Standings</SectionContent>

<div class="card shadow-sm border-0">
    <div class="card-header pqm-card-header flex-wrap">
        <span class="pqm-card-title">
            <span class="mif-trophy" aria-hidden="true"></span> Ranking
        </span>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @* Choice between labels, not an action: text instead of icons *@
            <div class="btn-group btn-group-sm" role="group" aria-label="Rank by">
                <button type="button"
                        class="btn @(sort == StandingsSort.Total ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Total ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Total)">
                    Total
                </button>
                <button type="button"
                        class="btn @(sort == StandingsSort.Average ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Average ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Average)">
                    Average
                </button>
                <button type="button"
                        class="btn @(sort == StandingsSort.Quizzes ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(sort == StandingsSort.Quizzes ? "true" : "false")"
                        @onclick="() => SetSort(StandingsSort.Quizzes)">
                    Quizzes
                </button>
            </div>
            <input type="search"
                   class="form-control form-control-sm"
                   style="width: 200px;"
                   placeholder="Search team…"
                   aria-label="Search team"
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (sort == StandingsSort.Average && data != null)
    {
        <div class="small text-muted px-3 py-2 border-bottom">
            Only teams that played at least @data.MinQuizzesForAverage of @data.QuizCount quiz nights (10 %) are ranked by average.
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-3">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Calculating standings…</span>
        </div>
    }
    else if (FilteredRows.Length == 0)
    {
        <div class="text-center text-muted p-4">
            No teams or rankings found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="small text-secondary">
                    <tr>
                        <th style="width: 70px;" class="text-center">Rank</th>
                        <th>Team</th>
                        <th style="width: 110px;" class="text-end @HeaderClass(StandingsSort.Quizzes)">Quizzes</th>
                        <th style="width: 110px;" class="text-end @HeaderClass(StandingsSort.Total)">Total</th>
                        <th style="width: 110px;" class="text-end pe-3 @HeaderClass(StandingsSort.Average)">Avg / Quiz</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        var entry = row.Team;
                        var currentRank = row.Rank;

                        <tr>
                            <td class="text-center fw-bold text-muted">
                                @if (currentRank == 1)
                                {
                                    <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 1
                                    </span>
                                }
                                else if (currentRank == 2)
                                {
                                    <span class="badge bg-secondary text-white d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 2
                                    </span>
                                }
                                else if (currentRank == 3)
                                {
                                    <span class="badge bg-danger text-white d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 3
                                    </span>
                                }
                                else
                                {
                                    <span>@currentRank</span>
                                }
                            </td>
                            <td class="fw-semibold">
                                <a class="text-decoration-none text-dark" href="/teams?teamId=@entry.TeamId">
                                    @entry.TeamName
                                </a>
                            </td>
                            <td class="text-end @CellClass(StandingsSort.Quizzes)">@entry.QuizzesPlayed</td>
                            <td class="text-end @CellClass(StandingsSort.Total)">@entry.TotalScore.ToString("0.#")</td>
                            <td class="text-end pe-3 @CellClass(StandingsSort.Average)">@entry.AverageScore.ToString("0.#")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

