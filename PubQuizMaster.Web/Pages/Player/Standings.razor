@page "/standings"
@using PubQuizMaster.Services
@using PubQuizMaster.Services.Player
@inject LeaderboardService LeaderboardService

<PageTitle>All-Time Standings – PubQuizMaster</PageTitle>
<SectionContent SectionName="@LayoutSections.PageTitle">All-Time Standings</SectionContent>

<div class="card shadow-sm border-0">
    <div class="card-header pqm-card-header">
        <span class="pqm-card-title">
            <span class="mif-trophy" aria-hidden="true"></span> Ranking
        </span>
        <input type="search"
               class="form-control form-control-sm"
               style="width: 220px;"
               placeholder="Search team…"
               aria-label="Search team"
               @bind="searchTerm"
               @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-3">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Calculating standings…</span>
        </div>
    }
    else if (FilteredEntries.Length == 0)
    {
        <div class="text-center text-muted p-4">
            No teams or rankings found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="small text-secondary">
                    <tr>
                        <th style="width: 70px;" class="text-center">Rank</th>
                        <th>Team</th>
                        <th style="width: 110px;" class="text-end">Quizzes</th>
                        <th style="width: 110px;" class="text-end">Total</th>
                        <th style="width: 110px;" class="text-end pe-3">Avg / Quiz</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in FilteredEntries)
                    {
                        var currentRank = entry.Rank;
                        var avg = entry.QuizzesPlayed > 0 ? entry.TotalScore / entry.QuizzesPlayed : 0m;

                        <tr>
                            <td class="text-center fw-bold text-muted">
                                @if (currentRank == 1)
                                {
                                    <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 1
                                    </span>
                                }
                                else if (currentRank == 2)
                                {
                                    <span class="badge bg-secondary text-white d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 2
                                    </span>
                                }
                                else if (currentRank == 3)
                                {
                                    <span class="badge bg-danger text-white d-inline-flex align-items-center gap-1">
                                        <span class="mif-trophy" aria-hidden="true"></span> 3
                                    </span>
                                }
                                else
                                {
                                    <span>@currentRank</span>
                                }
                            </td>
                            <td class="fw-semibold">
                                <a class="text-decoration-none text-dark" href="/teams?teamId=@entry.TeamId">
                                    @entry.TeamName
                                </a>
                            </td>
                            <td class="text-end">@entry.QuizzesPlayed</td>
                            <td class="text-end fw-bold text-primary">
                                @entry.TotalScore.ToString("0.#")
                            </td>
                            <td class="text-end pe-3 text-muted small">
                                @avg.ToString("0.#")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
