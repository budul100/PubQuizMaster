@namespace PubQuizMaster.Web.Components.Player

<div class="card shadow-sm border-0 h-100">
    <div class="card-header pqm-card-header">
        <span class="pqm-card-title">
            <span class="mif-group" aria-hidden="true"></span> Teams &amp; Standings (@Standings.Length)
        </span>
        <button class="btn btn-sm @(showAddTeamForm ? "btn-outline-secondary" : "btn-primary") py-0 px-2"
                title="@(showAddTeamForm ? "Close" : "Register team")"
                aria-label="@(showAddTeamForm ? "Close" : "Register team")"
                aria-expanded="@(showAddTeamForm ? "true" : "false")"
                @onclick="() => showAddTeamForm = !showAddTeamForm">
            <span class="@(showAddTeamForm ? "mif-cross" : "mif-plus")" aria-hidden="true"></span>
        </button>
    </div>

    @if (showAddTeamForm)
    {
        <div class="p-3 bg-light border-bottom">
            <label class="form-label small fw-bold mb-1">Add Team to Night</label>
            <TeamSelector @ref="teamSelectorRef"
                          @bind-Value="newTeamName"
                          OnCreateNewConfirmed="HandleNewTeamCreated"
                          OnTeamSelected="(t) => HandleExistingTeamSelected(t.Name)"
                          Placeholder="Enter team name…"
                          AddButtonText="Register" />
        </div>
    }

    <div class="table-responsive flex-grow-1" style="max-height: 650px; overflow-y: auto;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="small text-secondary">
                <tr>
                    <th class="text-end" style="width: 40px;">#</th>
                    <th>Team</th>
                    <th class="text-center" style="width: 50px;" title="Out of competition">OOC</th>
                    <th class="text-end" style="width: 70px;" title="Latest active round score">Round</th>
                    <th class="text-end" style="width: 70px;" title="Total score of the evening">Total</th>
                    <th class="text-end pe-3" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Standings.Length == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted small">
                            No teams registered yet. Use the plus button above to add teams.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Standings)
                    {
                        <tr class="@(!entry.IsActive ? "opacity-50 bg-light" : "")">
                            <td class="text-end fw-bold text-secondary small">
                                @(entry.IsActive ? entry.OverallRank.ToString() : "—")
                            </td>
                            <td class="fw-semibold text-truncate small" style="max-width: 160px;">
                                <span class="@(!entry.IsActive ? "text-decoration-line-through text-muted" : "")">
                                    @entry.TeamName
                                </span>
                                @if (entry.IsNonCompetitive)
                                {
                                    <span class="badge bg-secondary ms-1" title="Out of competition">OOC</span>
                                }
                                @if (!entry.IsActive)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input"
                                       checked="@entry.IsNonCompetitive"
                                       title="Out of competition"
                                       aria-label="Out of competition"
                                       @onchange="e => ToggleNonCompetitiveAsync(entry.TeamId, (bool)(e.Value ?? false))" />
                            </td>
                            <td class="text-end text-muted small">
                                @(entry.LatestRoundScore.HasValue ? entry.LatestRoundScore.Value.ToString("0.#") : "—")
                            </td>
                            <td class="text-end fw-bold text-primary small">
                                @entry.TotalScore.ToString("0.#")
                            </td>
                            <td class="text-end pe-3">
                                @if (entry.CanDelete)
                                {
                                    <button class="btn btn-outline-danger btn-sm py-0 px-2"
                                            title="Delete team from night"
                                            aria-label="Delete team from night"
                                            @onclick="() => OnRemoveTeam.InvokeAsync(entry.TeamId)">
                                        <span class="mif-bin" aria-hidden="true"></span>
                                    </button>
                                }
                                else
                                {
                                    var toggleText = entry.IsActive ? "Deactivate team" : "Reactivate team";
                                    <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                            title="@toggleText"
                                            aria-label="@toggleText"
                                            @onclick="() => ToggleActiveAsync(entry.TeamId, !entry.IsActive)">
                                        <span class="@(entry.IsActive ? "mif-cross" : "mif-checkmark")" aria-hidden="true"></span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
