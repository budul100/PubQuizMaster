@namespace PubQuizMaster.Web.Components.Player

<div class="card shadow-sm border-0 h-100">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
        <span class="fw-bold small">👥 TEAMS &amp; STANDINGS (@Standings.Length)</span>
        <button class="btn btn-sm btn-outline-light py-0 px-2" @onclick="() => showAddTeamForm = !showAddTeamForm">
            @(showAddTeamForm ? "✕ Close" : "+ Register Team")
        </button>
    </div>

    @if (showAddTeamForm)
    {
        <div class="p-3 bg-light border-bottom">
            <label class="form-label small fw-bold mb-1">Add Team to Night</label>
            <TeamSelector @bind-Value="newTeamName"
                          OnCreateNewConfirmed="HandleNewTeamCreated"
                          OnTeamSelected="(t) => HandleExistingTeamSelected(t.Name)"
                          Placeholder="Enter team name…"
                          AddButtonText="Register" />
        </div>
    }

    <div class="table-responsive flex-grow-1" style="max-height: 650px; overflow-y: auto;">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 36px;" class="text-center">#</th>
                    <th>Team</th>
                    <th style="width: 70px;" class="text-end" title="Latest active round score">Round</th>
                    <th style="width: 80px;" class="text-end pe-3" title="Total score of the evening">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Standings.Length == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted small">
                            No teams registered yet. Add teams above!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Standings)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary small">@entry.OverallRank</td>
                            <td class="fw-semibold text-truncate small" style="max-width: 180px;">
                                @entry.TeamName
                            </td>
                            <td class="text-end text-muted small">
                                @(entry.LatestRoundScore.HasValue? entry.LatestRoundScore.Value.ToString("0.#") : "—")
                            </td>
                            <td class="text-end pe-3 fw-bold text-primary small">
                                @entry.TotalScore.ToString("0.#")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>