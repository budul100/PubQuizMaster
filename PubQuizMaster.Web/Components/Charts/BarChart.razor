@namespace PubQuizMaster.Web.Components.Charts

@if (Points.Length == 0)
{
    <div class="text-muted small text-center py-3">@EmptyText</div>
}
else
{
    var plotWidth = ChartLayout.Width - ChartLayout.Left - ChartLayout.Right;
    var plotHeight = Height - ChartLayout.Top - ChartLayout.Bottom;
    var max = AxisMax;
    var slot = plotWidth / Points.Length;
    var barWidth = Math.Min(slot * 0.7, 48);
    var labelStep = ChartLayout.LabelStep(Points.Length);
    var showValues = Points.Length <= 16;

    <svg viewBox="0 0 @ChartLayout.Width.ToString(Inv) @Height.ToString(Inv)"
         style="width: 100%; height: auto; display: block;"
         role="img"
         aria-label="@AriaLabel">

        @* Grid: zero line, middle and top *@
        @foreach (var fraction in new[] { 0d, 0.5d, 1d })
        {
            var y = ChartLayout.Top + plotHeight * (1 - fraction);
            <line x1="@ChartLayout.Left.ToString(Inv)" x2="@((ChartLayout.Width - ChartLayout.Right).ToString(Inv))"
                  y1="@y.ToString(Inv)" y2="@y.ToString(Inv)"
                  stroke="var(--bs-border-color)" stroke-width="1" />
            <SvgText X="@(ChartLayout.Left - 6)" Y="@(y + 4)" Anchor="end" FontSize="11" Text="@((max * (decimal)fraction).ToString(ValueFormat))" />
        }

        @for (int i = 0; i < Points.Length; i++)
        {
            var point = Points[i];
            var barHeight = (double)(max > 0 ? Math.Clamp(point.Value / max, 0, 1) : 0) * plotHeight;
            var x = ChartLayout.Left + slot * i + (slot - barWidth) / 2;
            var y = ChartLayout.Top + plotHeight - barHeight;

            <g>
                <title>@(point.Tooltip ?? $"{point.Label}: {point.Value.ToString(ValueFormat)}")</title>
                <rect x="@x.ToString(Inv)" y="@y.ToString(Inv)"
                      width="@barWidth.ToString(Inv)" height="@barHeight.ToString(Inv)"
                      rx="2"
                      fill="@(point.IsHighlighted ? HighlightColor : Color)" />
                @if (showValues)
                {
                    <SvgText X="@(x + barWidth / 2)" Y="@(y - 4)" Anchor="middle" FontSize="10" Text="@(point.Value.ToString(ValueFormat))" />
                }
                @if (i % labelStep == 0)
                {
                    <SvgText X="@(x + barWidth / 2)" Y="@(Height - 8)" Anchor="middle" FontSize="11" Text="@point.Label" />
                }
            </g>
        }

        @if (ReferenceValue is { } reference && max > 0)
        {
            var y = ChartLayout.Top + plotHeight * (1 - (double)Math.Clamp(reference / max, 0, 1));
            <g>
                <title>@(ReferenceLabel ?? "Reference"): @reference.ToString(ValueFormat)</title>
                <line x1="@ChartLayout.Left.ToString(Inv)" x2="@((ChartLayout.Width - ChartLayout.Right).ToString(Inv))"
                      y1="@y.ToString(Inv)" y2="@y.ToString(Inv)"
                      stroke="var(--bs-danger)" stroke-width="1.5" stroke-dasharray="6 4" />
            </g>
        }
    </svg>
}
