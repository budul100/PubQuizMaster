@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Core.Enums
@using PubQuizMaster.Core.Models.Event
@using PubQuizMaster.Core.Models.Standings
@using PubQuizMaster.Services.Common
@using PubQuizMaster.Services.Event
@using PubQuizMaster.Web.Components.Charts
@using PubQuizMaster.Web.Components.Common
@using PubQuizMaster.Web.Components.Standings
@inject QuizService LiveQuizService
@inject ToastService ToastService
@inject NavigationManager Nav

@if (Difficulties.Length > 0)
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header pqm-card-header">
            <span class="pqm-card-title">
                <span class="mif-bar-chart" aria-hidden="true"></span> Correct Answers per Quiz Night
            </span>
            @if (AverageRate is { } average)
            {
                <span class="small text-muted">Average @average.ToString("0%")</span>
            }
        </div>
        @* Wide and flat: a large view width keeps the chart low across the full page width *@
        <div class="card-body py-1 px-2">
            <BarChart 
                Points="DifficultyPoints"
                Max="1"
                ValueFormat="0%"
                ReferenceValue="AverageRate"
                ReferenceLabel="Average of completed nights"
                Height="130"
                ViewWidth="1400"
                ShowValues="false"
                AriaLabel="Share of correct answers per quiz night" />
        </div>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header pqm-card-header">
        <span class="pqm-card-title">
            <span class="mif-calendar" aria-hidden="true"></span> Quizzes (@QuizNights.Count)
        </span>
        <div class="d-flex gap-2">
            @* A label, not a button: clicking it opens the file dialog of the hidden input.
            The changing @key recreates the input, otherwise the same file cannot be picked twice. *@
            <label class="btn btn-sm btn-primary py-0 px-2 mb-0 @(isSubmitting ? "disabled" : null)"
                   title="New quiz night from question file (JSON)"
                   aria-label="New quiz night from question file">
                <span class="mif-upload" aria-hidden="true"></span>
                <InputFile @key="@($"create-content-{inputVersion}")"
                           class="d-none"
                           accept=".json,application/json"
                           disabled="@isSubmitting"
                           OnChange="CreateQuizNightFromFileAsync" />
            </label>
            <button class="btn btn-sm btn-outline-primary py-0 px-2"
                    title="New quiz night"
                    aria-label="New quiz night"
                    disabled="@isSubmitting"
                    @onclick="CreateQuizNightAsync">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span class="mif-plus" aria-hidden="true"></span>
                }
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="small text-secondary">
                <tr>
                    <th class="ps-3" style="width: 110px;">Date</th>
                    <th>Title</th>
                    <th class="text-end" style="width: 80px;">Teams</th>
                    <th class="text-end" style="width: 80px;">Rounds</th>
                    <th class="text-end" style="width: 90px;" title="Share of correct answers, lower means harder">Correct</th>
                    <th class="text-end pe-3" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (QuizNights.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No quiz nights yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var quiz in OrderedQuizNights)
                    {
                        <tr class="@(quiz.Status == QuizStatus.Live ? "table-success" : null)"
                            style="cursor: pointer;"
                            @onclick="() => OpenQuiz(quiz)">
                            <td class="ps-3 small text-secondary">@quiz.Date.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="fw-semibold d-flex align-items-center gap-2">
                                    <span>@quiz.Title</span>
                                    @if (quiz.IsLegacyImport)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Import</span>
                                    }
                                    else if (quiz.Status == QuizStatus.Live)
                                    {
                                        <span class="badge bg-success">Live</span>
                                    }
                                    else if (quiz.Status == QuizStatus.Planned)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">Planned</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(quiz.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 300px;">
                                        @quiz.Description
                                    </div>
                                }
                            </td>
                            <td class="text-end small">@(quiz.IsLegacyImport ? quiz.Results.Count : quiz.ParticipatingTeams.Count)</td>
                            <td class="text-end small">@(quiz.IsLegacyImport ? quiz.ImportedRoundCount?.ToString() ?? "–" : quiz.Rounds.Count.ToString())</td>
                            <td class="text-end small">@(RateOf(quiz)?.ToString("0%") ?? "–")</td>
                            <td class="pqm-actions-cell pe-3">
                                <div class="pqm-row-actions">
                                    @* stopPropagation: the row itself opens the quiz *@
                                    <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                            title="Delete quiz night"
                                            aria-label="Delete quiz night"
                                            @onclick="() => PromptDelete(quiz)"
                                            @onclick:stopPropagation="true">
                                        <span class="mif-bin" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<ConfirmModal 
    IsOpen="@showDeleteModal"
    Title="Delete Quiz Night"
    Message="@($"Are you sure you want to delete \"{quizToDelete?.Title}\"? This will permanently remove all associated rounds, teams, and answers.")"
    ConfirmText="Yes, Delete"
    OnConfirmed="HandleDeleteConfirmedAsync"
    OnCanceled="() => showDeleteModal = false" />
