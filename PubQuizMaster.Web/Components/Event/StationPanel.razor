@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Core.Enums

<div class="card shadow-sm border-0">
    <div class="card-header pqm-card-header">
        <span class="pqm-card-title">
            <span class="mif-qrcode" aria-hidden="true"></span> Scorer Stations (@Stations.Length)
        </span>
        <button class="btn btn-sm btn-primary py-0 px-2"
                title="Add station"
                aria-label="Add station"
                disabled="@isBusy"
                @onclick="AddStationAsync">
            <span class="mif-add-person" aria-hidden="true"></span>
        </button>
    </div>

    @if (Stations.Length == 0)
    {
        <div class="text-center py-4 text-muted small">
            No stations yet. Add one per scorer, they can log in before the first round.
        </div>
    }
    else
    {
        <div class="row g-2 p-2">
            @foreach (var station in Stations)
            {
                var scorerUrl = GetScorerUrl(station.ScorerId);
                var qrCodeDataUrl = QrCodeService.GetQrCodeDataUrl(scorerUrl);
                var isConnected = SessionService.IsConnected(station.ScorerId);
                var isPracticing = isConnected && SessionService.GetStatus(station.ScorerId)?.Phase == ScoringType.Practicing;

                <div class="col-12 col-md-6 col-xl-4" @key="station.Id">
                    <div class="card h-100 border p-2 bg-light">
                        <div class="d-flex gap-2 align-items-start">
                            <button type="button"
                                    class="flex-shrink-0 bg-white p-1 rounded border"
                                    title="Show large QR code"
                                    @onclick="() => zoomStation = station">
                                <img src="@qrCodeDataUrl"
                                     alt="QR code for @station.Label"
                                     style="width: 128px; height: 128px; image-rendering: pixelated;" />
                            </button>
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="d-flex gap-1 align-items-center mb-2">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           value="@station.Label"
                                           aria-label="Station label"
                                           disabled="@isBusy"
                                           @onchange="e => RenameStationAsync(station, e.Value?.ToString())" />
                                    <span class="badge @(isPracticing ? "bg-warning text-dark" : isConnected ? "bg-success" : "bg-danger")" style="font-size: 0.65rem;">
                                        @(isPracticing ? "Practicing" : isConnected ? "Online" : "Offline")
                                    </span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text"
                                           class="form-control font-monospace"
                                           value="@station.ScorerId"
                                           readonly
                                           title="Scorer token" />
                                    <a class="btn btn-outline-secondary"
                                       href="@scorerUrl"
                                       target="_blank"
                                       title="Open scorer page"
                                       aria-label="Open scorer page">
                                        <span class="mif-external" aria-hidden="true"></span>
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            title="Generate new token"
                                            aria-label="Generate new token"
                                            disabled="@isBusy"
                                            @onclick="() => RegenerateTokenAsync(station)">
                                        <span class="mif-refresh" aria-hidden="true"></span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            title="Remove station"
                                            aria-label="Remove station"
                                            disabled="@isBusy"
                                            @onclick="() => RemoveStationAsync(station)">
                                        <span class="mif-bin" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<QrZoomModal 
    IsOpen="@(zoomStation != null)"
    Label="@(zoomStation?.Label ?? string.Empty)"
    Url="@(zoomStation == null ? string.Empty : GetScorerUrl(zoomStation.ScorerId))"
    QrCodeDataUrl="@(zoomStation == null ? string.Empty : QrCodeService.GetQrCodeDataUrl(GetScorerUrl(zoomStation.ScorerId)))"
    OnClosed="() => zoomStation = null" />
