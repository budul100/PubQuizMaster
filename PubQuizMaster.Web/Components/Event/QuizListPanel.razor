@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Core.Models.Event
@using PubQuizMaster.Core.Records.Event
@using PubQuizMaster.Services.Common
@using PubQuizMaster.Services.Event
@using PubQuizMaster.Web.Components.Common
@using PubQuizMaster.Web.Services
@inject QuizService LiveQuizService
@inject ToastService ToastService
@inject PresentationDownloadService PresentationDownloadService
@inject ScorerService SessionService

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <span class="mif-calendar text-primary" aria-hidden="true"></span> Quiz Nights
        </h4>
        <small class="text-muted">Manage scheduled and historic quiz sessions</small>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Create New Quiz Night Form -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-semibold py-2">
                New Quiz Night
            </div>
            <div class="card-body">
                @if (HasActiveQuiz)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <span class="mif-warning" aria-hidden="true"></span> <strong>Active Quiz in Progress:</strong> You cannot create a new quiz while another quiz is currently active.
                    </div>
                }

                <fieldset disabled="@HasActiveQuiz">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Title</label>
                        <input type="text" class="form-control" @bind="newTitle" placeholder="e.g. Pub Quiz #42" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Date</label>
                        <input type="date" class="form-control" @bind="newDate" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description (Optional)</label>
                        <textarea class="form-control" rows="2" @bind="newDescription" placeholder="Notes, special rounds, or theme..."></textarea>
                    </div>

                    <button class="btn btn-primary w-100" @onclick="CreateQuizNightAsync" disabled="@(isSubmitting || HasActiveQuiz)">
                        @(isSubmitting ? "Creating…" : "+ Create Quiz Night")
                    </button>
                </fieldset>
            </div>
        </div>
    </div>

    <!-- Right Column: Quiz Nights List -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header fw-semibold bg-light py-2 d-flex justify-content-between align-items-center">
                <span>All Events (@QuizNights.Count)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 110px;">Date</th>
                            <th>Title</th>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 80px;" class="text-center">Teams</th>
                            <th style="width: 80px;" class="text-center">Rounds</th>
                            <th style="width: 180px;" class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm me-1" role="status"></div>
                                    Loading events…
                                </td>
                            </tr>
                        }
                        else if (QuizNights.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No quiz events found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var quiz in QuizNights)
                            {
                                var isActive = !quiz.IsCompleted && !quiz.IsLegacyImport;
                                <tr class="@(isActive ? "table-primary bg-opacity-25" : "")">
                                    <td class="small text-secondary">@quiz.Date.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="fw-semibold">
                                            @if (isActive)
                                            {
                                                <span class="text-primary fw-bold d-inline-flex align-items-center gap-1 cursor-pointer"
                                                      role="button"
                                                      @onclick="() => OnSelectQuiz.InvokeAsync(quiz.Id)">
                                                    <span class="mif-target" aria-hidden="true"></span> @quiz.Title
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-dark cursor-pointer" role="button" @onclick="() => OpenEditModal(quiz)">
                                                    @quiz.Title
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(quiz.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 250px;">
                                                @quiz.Description
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (quiz.IsLegacyImport)
                                        {
                                            <span class="badge bg-secondary">Legacy</span>
                                        }
                                        else if (quiz.IsCompleted)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Active</span>
                                        }
                                    </td>
                                    <td class="text-center small">@quiz.ParticipatingTeams.Count</td>
                                    <td class="text-center small">@quiz.Rounds.Count</td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            @if (isActive)
                                            {
                                                <button class="btn btn-outline-primary py-0 px-2"
                                                        title="Go to Live Scoring"
                                                        @onclick="() => OnSelectQuiz.InvokeAsync(quiz.Id)">
                                                    Live
                                                </button>
                                            }
                                            @if (quiz.IsCompleted && !quiz.IsLegacyImport)
                                            {
                                                var canExport = quiz.Rounds.Any(r => r.IsFinalized);
                                                var exportDisabled = !canExport || exportingQuizId != null;
                                                <label class="btn btn-outline-primary py-0 px-2 mb-0 @(exportDisabled ? "disabled" : null)"
                                                       title="@(canExport ? "Select presentation and export final results" : "No finalized round to export")">
                                                    @if (exportingQuizId == quiz.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                                    }
                                                    else
                                                    {
                                                        <span>PPTX</span>
                                                    }
                                                    <InputFile @key="@($"{quiz.Id}-{exportVersion}")"
                                                               class="d-none"
                                                               accept=".pptx,.ppsx,.potx"
                                                               disabled="@exportDisabled"
                                                               OnChange="e => ExportFinalAsync(quiz, e.File)" />
                                                </label>
                                                <button class="btn btn-outline-warning py-0 px-2"
                                                        disabled="@HasActiveQuiz"
                                                        title="@(HasActiveQuiz ? "Complete the active quiz night first" : "Reopen quiz night")"
                                                        aria-label="Reopen quiz night"
                                                        @onclick="() => PromptReopen(quiz)">
                                                    <span class="mif-undo" aria-hidden="true"></span>
                                                </button>
                                            }
                                            <button class="btn btn-outline-secondary py-0 px-2"
                                                    @onclick="() => OpenEditModal(quiz)"
                                                    title="Edit Name & Date"
                                                    aria-label="Edit Name & Date">
                                                <span class="mif-pencil" aria-hidden="true"></span>
                                            </button>
                                            <button class="btn btn-outline-danger py-0 px-2"
                                                    @onclick="() => PromptDelete(quiz)"
                                                    title="Delete Quiz"
                                                    aria-label="Delete Quiz">
                                                <span class="mif-bin" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<QuizEditModal IsOpen="@showEditModal"
               Quiz="@quizToEdit"
               OnSaved="HandleQuizSavedAsync"
               OnCanceled="() => showEditModal = false" />

<ConfirmModal IsOpen="@showDeleteModal"
              Title="Delete Quiz Night"
              Message="@($"Are you sure you want to delete \"{quizToDelete?.Title}\"? This will permanently remove all associated rounds, teams, and answers.")"
              ConfirmText="Yes, Delete"
              OnConfirmed="HandleDeleteConfirmedAsync"
              OnCanceled="() => showDeleteModal = false" />

<ConfirmModal IsOpen="@showReopenModal"
              Title="Reopen Quiz Night"
              Message="@($"Reopen \"{quizToReopen?.Title}\"? It becomes the active quiz night again and is removed from the all-time standings until it is completed.")"
              ConfirmText="Reopen"
              ConfirmButtonClass="btn-warning"
              HeaderClass="bg-warning"
              OnConfirmed="HandleReopenConfirmedAsync"
              OnCanceled="() => showReopenModal = false" />