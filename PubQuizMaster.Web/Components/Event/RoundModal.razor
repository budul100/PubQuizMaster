@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Web.Components.Standings
@using PubQuizMaster.Web.Helpers

@if (IsOpen && Quiz != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white py-2">
                    <h5 class="modal-title fw-bold">Start New Round</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@ErrorMessage</div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label small fw-bold">Round Name</label>
                            <input type="text" class="form-control" @bind="roundName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Question Count</label>
                            <input type="number" class="form-control" min="1" max="@QuizService.MaxQuestionCount" @bind="questionCount" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkFinalRound" @bind="isFinalRound" />
                                <label class="form-check-label small fw-bold text-success" for="chkFinalRound">
                                    Final Round of the Night
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0">Scorer Assignments (@assignments.Count Scorers)</h6>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="Distribute teams evenly across scorers"
                                    aria-label="Distribute teams evenly across scorers"
                                    @onclick="AutoDistributeTeams">
                                <span class="mif-shuffle" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    title="Add scorer"
                                    aria-label="Add scorer"
                                    @onclick="AddScorer">
                                <span class="mif-add-person" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3 mb-2">
                        @for (int s = 0; s < assignments.Count; s++)
                        {
                            var sIdx = s;
                            var sc = assignments[sIdx];

                            <div class="card border p-3 bg-light">
                                <div class="row g-2 align-items-center mb-2">
                                    <div class="col-md-5">
                                        <input type="text" class="form-control form-control-sm" placeholder="Label (e.g. Scorer A)" @bind="sc.Label" />
                                    </div>
                                    <div class="col-md-5">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control font-monospace" value="@sc.ScorerId" readonly title="Scorer token" />
                                            <button type="button" class="btn btn-outline-secondary"
                                                    title="Generate new token"
                                                    aria-label="Generate new token"
                                                    @onclick="() => sc.ScorerId = ScorerTokens.Create()">
                                                <span class="mif-refresh" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                title="Remove scorer"
                                                aria-label="Remove scorer"
                                                disabled="@(assignments.Count <= 1)"
                                                @onclick="() => RemoveScorer(sIdx)">
                                            <span class="mif-bin" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </div>

                                <div class="small fw-semibold text-secondary mb-1">Assigned Teams (@sc.TeamIds.Count):</div>
                                @if (sc.TeamIds.Count == 0)
                                {
                                    <div class="small text-warning-emphasis mb-1">
                                        No teams yet. The station waits and receives late registrations first.
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var pt in Quiz.ParticipatingTeams.Where(p => p.IsActive).OrderBy(p => p.SheetOrder))
                                    {
                                        var isAssignedToThis = sc.TeamIds.Contains(pt.TeamId);
                                        var isAssignedToOther = !isAssignedToThis && assignments.Any(other => other != sc && other.TeamIds.Contains(pt.TeamId));

                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="checkbox"
                                                   id="@($"chk_{sIdx}_{pt.TeamId}")"
                                                   checked="@isAssignedToThis"
                                                   disabled="@isAssignedToOther"
                                                   @onchange="(e) => ToggleTeam(sc, pt.TeamId, (bool)(e.Value ?? false))" />
                                            <label class="form-check-label small @(isAssignedToOther ? "text-muted" : "")" for="@($"chk_{sIdx}_{pt.TeamId}")">
                                                @pt.Team.Name
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="SubmitAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Starting…</span>
                        }
                        else
                        {
                            <span class="mif-play" aria-hidden="true"></span>
                            <span>Start Round</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
