@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Core.Enums
@using PubQuizMaster.Web.Records
@using Microsoft.AspNetCore.Components.Forms

<div class="card shadow-sm border-0 h-100">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="fw-bold small">🎯 QUIZ ROUNDS (@Rounds.Count)</span>
        @if (ActiveRound == null)
        {
            <button class="btn btn-sm btn-primary py-0 px-2" @onclick="OnStartRoundClick">
                ▶ Start Next Round
            </button>
        }
    </div>

    <div class="table-responsive flex-grow-1">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Round</th>
                    <th style="width: 70px;">Questions</th>
                    <th style="width: 90px;">Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Rounds.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted small">
                            No rounds started yet. Click "Start Next Round" to begin!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var round in Rounds)
                    {
                        var isCurrent = ActiveRound?.Id == round.Id;
                        <tr>
                            <td class="fw-semibold small">@round.Name</td>
                            <td class="small text-muted">@round.QuestionCount</td>
                            <td>
                                @if (round.IsFinalized)
                                {
                                    <span class="badge bg-success small">Completed</span>
                                }
                                else if (isCurrent)
                                {
                                    <span class="badge bg-primary small">Scoring</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary small">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary py-0 px-2" href="/matrix/@round.Id" title="Open Matrix">
                                        Matrix
                                    </a>
                                    @if (round.IsFinalized)
                                    {
                                        <label class="btn btn-outline-primary py-0 px-2 mb-0 @(IsExporting ? "disabled" : null)"
                                               title="Select presentation and export round results">
                                            Round
                                            <InputFile @key="@($"{round.Id}-round-{inputVersion}")"
                                                       class="d-none"
                                                       accept=".pptx,.ppsx,.potx"
                                                       disabled="@IsExporting"
                                                       OnChange="e => ExportAsync(round.Id, PresentationMode.Round, e)" />
                                        </label>
                                        <label class="btn btn-outline-success py-0 px-2 mb-0 @(IsExporting ? "disabled" : null)"
                                               title="Select presentation and export final results with podium">
                                            Final
                                            <InputFile @key="@($"{round.Id}-final-{inputVersion}")"
                                                       class="d-none"
                                                       accept=".pptx,.ppsx,.potx"
                                                       disabled="@IsExporting"
                                                       OnChange="e => ExportAsync(round.Id, PresentationMode.Final, e)" />
                                        </label>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

