@namespace PubQuizMaster.Web.Components.Event
@using PubQuizMaster.Core.Enums
@using PubQuizMaster.Web.Records
@using Microsoft.AspNetCore.Components.Forms

<div class="card shadow-sm border-0 h-100">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="fw-bold small d-flex align-items-center gap-1">
            <span class="mif-target text-primary" aria-hidden="true"></span> QUIZ ROUNDS (@Rounds.Count)
        </span>
        @if (ActiveRound == null)
        {
            <button class="btn btn-sm btn-primary py-0 px-2 d-flex align-items-center gap-1" @onclick="OnStartRoundClick">
                <span class="mif-play" aria-hidden="true"></span> Start Next Round
            </button>
        }
    </div>

    <div class="table-responsive flex-grow-1">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Round</th>
                    <th style="width: 50px;" class="text-center" title="Final round of the quiz night">Final</th>
                    <th style="width: 60px;">Q</th>
                    <th style="width: 80px;">Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Rounds.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted small">
                            No rounds started yet. Click "Start Next Round" to begin!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var round in Rounds)
                    {
                        var isCurrent = ActiveRound?.Id == round.Id;
                        <tr>
                            <td class="fw-semibold small">
                                @round.Name
                                @if (round.IsFinal)
                                {
                                    <span class="badge bg-success ms-1">Final</span>
                                }
                            </td>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input"
                                       checked="@round.IsFinal"
                                       title="Toggle Final Round"
                                       aria-label="Toggle Final Round"
                                       @onchange="e => OnToggleFinal.InvokeAsync((round.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td class="small text-muted">@round.QuestionCount</td>
                            <td>
                                @if (round.IsFinalized)
                                {
                                    <span class="badge bg-success small">Completed</span>
                                }
                                else if (isCurrent)
                                {
                                    <span class="badge bg-primary small">Scoring</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary small">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary py-0 px-2" href="/matrix/@round.Id" title="Open Matrix">
                                        Matrix
                                    </a>
                                    @if (round.IsFinalized)
                                    {
                                        <label class="btn btn-outline-primary py-0 px-2 mb-0 @(IsExporting ? "disabled" : null)"
                                               title="@(round.IsFinal ? "Export final results and podium" : "Export round results")">
                                            Export
                                            <InputFile @key="@($"{round.Id}-export-{inputVersion}")"
                                                       class="d-none"
                                                       accept=".pptx,.ppsx,.potx"
                                                       disabled="@IsExporting"
                                                       OnChange="e => ExportAsync(round, e)" />
                                        </label>
                                    }
                                    @if (round.Answers.Count == 0)
                                    {
                                        <button class="btn btn-outline-danger py-0 px-2"
                                                title="Delete Round"
                                                aria-label="Delete Round"
                                                @onclick="() => OnDeleteRound.InvokeAsync(round)">
                                            <span class="mif-bin" aria-hidden="true"></span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>