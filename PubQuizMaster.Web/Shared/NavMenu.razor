@using PubQuizMaster.Web.Helpers
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="">
            <span class="mif-target text-danger" aria-hidden="true"></span> PubQuizMaster
        </a>
    </div>
</div>

<div class="nav-scrollable p-2">
    <nav class="nav flex-column gap-1">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="mif-play" aria-hidden="true"></span> Quiz
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/standings" Match="NavLinkMatch.Prefix">
                <span class="mif-trophy" aria-hidden="true"></span> Standings
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/teams" Match="NavLinkMatch.Prefix">
                <span class="mif-group" aria-hidden="true"></span> Teams
            </NavLink>
        </div>

        <div class="nav-section-label">Options</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="/legacy-import" Match="NavLinkMatch.Prefix">
                <span class="mif-upload" aria-hidden="true"></span> Import
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    @* Plain link with target="_top": logout is a Razor Page outside the Blazor circuit *@
                    <a class="nav-link" href="/logout" target="_top">
                        <span class="mif-exit" aria-hidden="true"></span> Logout
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

<div class="sidebar-version">Version @AppVersion.Current</div>
