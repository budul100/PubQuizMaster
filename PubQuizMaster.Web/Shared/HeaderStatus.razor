@if (info != null)
{
    <a class="badge header-badge header-badge-info text-decoration-none" href="/live" title="Running round, open the live quiz night">
        <span class="mif-play" aria-hidden="true"></span> @info.RoundName
    </a>

    @if (info.ScorerIds.Length > 0)
    {
        var online = OnlineCount;
        var total = info.ScorerIds.Length;

        <span class="badge header-badge @(online == total ? "header-badge-ok" : "header-badge-warn")"
              title="Scorer stations online">
            <span class="mif-wifi" aria-hidden="true"></span> @online / @total online
        </span>
    }
}
