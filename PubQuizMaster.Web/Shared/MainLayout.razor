@using PubQuizMaster.Core
@inherits LayoutComponentBase

<div class="page">
    <ToastVisualizer />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center gap-3">
            @* Filled by each page via <SectionContent SectionName="@LayoutSections.PageTitle"> *@
            <span class="fw-semibold text-truncate">
                <SectionOutlet SectionName="@Constants.PageTitle" />
            </span>
            <div class="d-flex gap-2 align-items-center flex-shrink-0">
                <HeaderStatus />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
