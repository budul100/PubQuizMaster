@inherits LayoutComponentBase

<div class="page">
    <ToastVisualizer />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-secondary">PubQuizMaster</span>
            <div class="d-flex gap-2 align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-outline-secondary btn-sm py-0" href="/logout" target="_top">Logout</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>