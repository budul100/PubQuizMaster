@using PubQuizMaster.Core
@using PubQuizMaster.Web.Components.Standings
@* Authentication state is provided via AddCascadingAuthenticationState() in Program.cs *@
<Router AppAssembly="@typeof(App).Assembly">

    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.MainLayout)">
            <NotAuthorized>
                <LoginRedirect />
            </NotAuthorized>
            <Authorizing>
                <p class="text-muted p-3">Checking access…</p>
            </Authorizing>
        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <PageTitle>Not found</PageTitle>

        <SectionContent SectionName="@Constants.PageTitle">Not found</SectionContent>

        <LayoutView Layout="@typeof(Shared.MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>

</Router>
