<!-- ===== SidebarView.axaml ===== -->
<!-- DataContext: SidebarViewModel -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PubQuizMaster.Desktop.ViewModels"
             x:Class="PubQuizMaster.Desktop.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <TabControl>

        <TabItem Header="Standings">
            <DockPanel Margin="0 8 0 0">
                <TextBlock DockPanel.Dock="Top"
                           IsVisible="{Binding !HasResults}"
                           Text="No rounds played yet."
                           Foreground="#4a4a6a" FontSize="12"
                           HorizontalAlignment="Center" Margin="0 20 0 0"/>

                <StackPanel IsVisible="{Binding HasResults}" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding LastRoundLabel}"
                                   FontSize="11" FontWeight="Bold" Foreground="#9999bb"/>
                        <ItemsControl ItemsSource="{Binding LastRoundBoard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                                    <Grid ColumnDefinitions="22,*,Auto" Margin="0 2">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                   Foreground="#4a4a6a" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TeamName}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}"
                                                   Foreground="#e94560" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="#0f3460"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#9999bb"/>
                        <ItemsControl ItemsSource="{Binding TotalBoard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                                    <Grid ColumnDefinitions="22,*,Auto" Margin="0 2">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                   Foreground="#4a4a6a" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TeamName}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}"
                                                   Foreground="#2ecc71" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>

        <TabItem Header="Rounds">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0 8 0 0">
                <ItemsControl ItemsSource="{Binding AllRounds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoundMatrixViewModel">
                            <Expander IsExpanded="True" Margin="0 0 0 12">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Width="220">
                                        <TextBlock Grid.Column="0" Text="{Binding RoundName}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Edit"
                                                Padding="6 2" FontSize="11"
                                                IsVisible="{Binding !IsEditing}"
                                                Command="{Binding EditCommand}"
                                                Margin="0 0 4 0"/>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal" Spacing="4"
                                                    IsVisible="{Binding IsEditing}">
                                            <Button Content="Save" Padding="6 2"
                                                    FontSize="11" Classes="primary"
                                                    Command="{Binding SaveCommand}"/>
                                            <Button Content="✕" Padding="6 2"
                                                    FontSize="11" Classes="danger"
                                                    Command="{Binding CancelCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="4 6 0 0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Team" Width="80"
                                                   FontSize="11" Foreground="#9999bb"/>
                                        <ItemsControl ItemsSource="{Binding QuestionHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Width="28"
                                                               FontSize="11" Foreground="#9999bb"
                                                               TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="S" Width="28" FontSize="11"
                                                   Foreground="#9999bb" TextAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TeamAnswerRowViewModel">
                                                <StackPanel Orientation="Horizontal" Margin="0 2">
                                                    <TextBlock Text="{Binding TeamName}"
                                                               Width="80" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <ItemsControl ItemsSource="{Binding Answers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AnswerCellViewModel">
                                                                <Panel Width="28" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Display}"
                                                                               Foreground="{Binding Color}"
                                                                               FontSize="13"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding !IsEditing}"/>
                                                                    <CheckBox IsChecked="{Binding IsCorrect}"
                                                                              IsThreeState="True"
                                                                              IsVisible="{Binding IsEditing}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Total}"
                                                               Width="28" FontSize="12"
                                                               Foreground="#e94560" FontWeight="Bold"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="#0f3460" Margin="0 4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Correct" Width="80"
                                                   FontSize="11" Foreground="#9999bb"
                                                   VerticalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding ColSums}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Width="28"
                                                               FontSize="12" Foreground="#2ecc71"
                                                               FontWeight="Bold" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>
