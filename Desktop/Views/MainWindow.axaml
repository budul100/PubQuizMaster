<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PubQuizMaster.Desktop.ViewModels"
        xmlns:views="using:PubQuizMaster.Desktop.Views"
        x:Class="PubQuizMaster.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PubQuizMaster – Host"
        Width="1200" Height="720"
        Background="#1a1a2e">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#eaeaea"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#eaeaea"/>
            <Setter Property="BorderBrush" Value="#4a4a6a"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#eaeaea"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#e94560"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#c0392b"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Padding="16 12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="🎯 PubQuizMaster" FontSize="18" FontWeight="Bold"
                               Foreground="#e94560"/>
                    <TextBlock Text="{Binding QuizNightName}" FontSize="14"
                               Foreground="#9999bb" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🌐" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerUrl}" FontSize="12"
                               Foreground="#9999bb" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Spalten-Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,*,4,*">

            <!-- ================================================================
            SETUP — Panel als Wrapper, damit IsVisible auf Main-VM bleibt
            und DataContext trotzdem auf SetupViewModel zeigt
            ================================================================ -->
            <Panel Grid.Column="0" Grid.ColumnSpan="3"
                   IsVisible="{Binding IsSetup}">
                <views:SetupView DataContext="{Binding Setup}"
                                 Margin="16 16 0 72"/>
                <Button Content="▶  Start Round"
                        Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="16" Padding="0 14"
                        Margin="16 0 8 16"
                        IsEnabled="{Binding Setup.CanStartRound}"
                        Command="{Binding StartRoundCommand}"/>
            </Panel>

            <!-- ================================================================
            ACTIVE ROUND
            ================================================================ -->
            <Grid Grid.Column="0" Grid.ColumnSpan="4"
                  IsVisible="{Binding IsActiveRound}"
                  RowDefinitions="*,Auto"
                  Margin="16 16 0 16">
                <views:ActiveRoundView Grid.Row="0"
                                       DataContext="{Binding ActiveRound}"/>
                <Button Grid.Row="1"
                        Content="⏹  Finalize Round"
                        Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="16" Padding="0 14"
                        Margin="0 12 0 0"
                        Command="{Binding FinalizeRoundCommand}"/>
            </Grid>

            <!-- ================================================================
            RESULTS
            ================================================================ -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4"
                        IsVisible="{Binding IsResults}"
                        Spacing="16"
                        VerticalAlignment="Center"
                        Margin="16 0 0 0">
                <TextBlock Text="Round complete! Results are shown on the right."
                           Foreground="#9999bb" HorizontalAlignment="Center"/>
                <Button Content="▶  Next Round"
                        Classes="primary"
                        HorizontalAlignment="Center"
                        Padding="32 14" FontSize="16"
                        Command="{Binding NextRoundCommand}"/>
            </StackPanel>

            <!-- ================================================================
            SPLITTER — immer sichtbar
            ================================================================ -->
            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Background="#0f3460"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ================================================================
            SIDEBAR — immer sichtbar
            ================================================================ -->
            <Border Grid.Column="4" Background="#16213e" CornerRadius="8"
                    Margin="0 16 16 16" Padding="12">
                <Border.Styles>
                    <Style Selector="TabControl">
                        <Setter Property="Background" Value="#16213e"/>
                    </Style>
                    <Style Selector="TabItem">
                        <Setter Property="Background" Value="#0f3460"/>
                        <Setter Property="Foreground" Value="#eaeaea"/>
                        <Setter Property="Padding" Value="10 6"/>
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Background" Value="#16213e"/>
                        <Setter Property="Foreground" Value="#e94560"/>
                    </Style>
                    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                        <Setter Property="Background" Value="#e94560"/>
                    </Style>
                    <Style Selector="Expander">
                        <Setter Property="Foreground" Value="#eaeaea"/>
                    </Style>
                    <Style Selector="Expander /template/ ToggleButton">
                        <Setter Property="Foreground" Value="#eaeaea"/>
                    </Style>
                    <Style Selector="CheckBox">
                        <Setter Property="Foreground" Value="#eaeaea"/>
                    </Style>
                </Border.Styles>

                <views:SidebarView DataContext="{Binding Sidebar}"/>
            </Border>

        </Grid>
    </Grid>
</Window>
