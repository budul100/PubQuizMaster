<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PubQuizMaster.Desktop.ViewModels"
             xmlns:views="using:PubQuizMaster.Desktop.Views"
             x:Class="PubQuizMaster.Desktop.Views.RoundMatrixView"
             x:DataType="vm:RoundMatrixViewModel">
    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                CornerRadius="8"
                Padding="12 10"
                Margin="0 0 0 12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock Text="{Binding RoundName}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✓ Save"
                            Classes="primary"
                            IsVisible="{Binding IsEditing}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="✕ Cancel"
                            Classes="danger"
                            IsVisible="{Binding IsEditing}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="✎ Edit"
                            IsVisible="{Binding !IsEditing}"
                            Command="{Binding EditCommand}"/>
                    <Button Content="🗑 Delete"
                            Classes="danger"
                            IsVisible="{Binding IsEditing}"
                            Command="{Binding DeleteRoundCommand}"/>
                    <Button Content="↗ Export"
                            Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Matrix -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4 0 0 0">
                <!-- Header row -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Team"
                               Width="140"
                               FontSize="11"
                               Foreground="{StaticResource BrushSubtext}"/>

                    <TextBlock Text="#R"
                               Width="44"
                               FontSize="11"
                               Foreground="{StaticResource BrushSubtext}"
                               TextAlignment="Center"/>
                    <TextBlock Text="#T"
                               Width="44"
                               FontSize="11"
                               Foreground="{StaticResource BrushSubtext}"
                               TextAlignment="Center"/>

                    <TextBlock Text="Pts"
                               Width="44"
                               FontSize="11"
                               Foreground="{StaticResource BrushSubtext}"
                               TextAlignment="Center"/>

                    <ItemsControl ItemsSource="{Binding QuestionHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Width="32"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushSubtext}"
                                           TextAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
                <!-- Correct-per-question sums (directly under header) -->
                <StackPanel Orientation="Horizontal"
                            Margin="0 2 0 2">

                    <TextBlock Text="Correct"
                               Width="140"
                               FontSize="11"
                               Foreground="{StaticResource BrushSubtext}"
                               VerticalAlignment="Center"/>

                    <TextBlock Width="44"/>
                    <TextBlock Width="44"/>

                    <TextBlock Text="{Binding TotalCorrectCount}"
                               Width="44"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushCorrect}"
                               TextAlignment="Center"/>

                    <ItemsControl ItemsSource="{Binding ColSums}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Width="32"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushCorrect}"
                                           TextAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- Divider -->
                <Border Height="1"
                        Background="{StaticResource BrushCard}"
                        Margin="0 4 0 4"/>

                <!-- Team rows -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamAnswerRowViewModel">
                            <views:TeamAnswerRowView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
